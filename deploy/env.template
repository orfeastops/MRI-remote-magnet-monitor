PORT=3002

# ── Set these before starting ─────────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-unique-password

# ── Pre-generated keys (DO NOT change — changing breaks existing sessions) ────
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_REFRESH_SECRET=replace-with-another-64-random-characters

# ── VAPID keys (Web Push notifications) ──────────────────────────────────────
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_KEY=replace-with-generated-private-key
VAPID_SUBJECT=mailto:admin@example.com
